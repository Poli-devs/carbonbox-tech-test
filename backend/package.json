{
  "name": "carbonbox-backend",
  "version": "1.0.0",
  "description": "CarbonBox Async Document Processing Backend",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "tsx watch src/main/index.ts",
    "worker": "tsx watch src/workers/FileProcessingWorker.ts",
    "build": "tsc",
    "start": "node dist/main/index.js",
    "start:worker": "node dist/workers/FileProcessingWorker.js",
    "prisma:generate": "prisma generate --schema=src/document-processing/infrastructure/persistence/models/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/document-processing/infrastructure/persistence/models/schema.prisma --name init",
    "prisma:deploy": "prisma migrate deploy --schema=src/document-processing/infrastructure/persistence/models/schema.prisma",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@prisma/client": "^5.19.1",
    "convict": "^6.2.4",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pino": "^9.4.0"
  },
  "devDependencies": {
    "@types/convict": "^6.1.6",
    "@types/node": "^20.16.5",
    "pino-pretty": "^11.2.2",
    "prisma": "^5.19.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
